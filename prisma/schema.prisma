generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String         @id @default(cuid())
  name                 String?
  email                String         @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  language             String         @default("en")
  stripeCustomerId     String?
  subscriptionPlan     String         @default("none")
  subscriptionStatus   String         @default("inactive")
  stripeSubscriptionId String?
  onboardingDismissedAt DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  properties           Property[]
  notifications        Notification[]
  platformImports      PlatformImport[]
  platformColumnMappings PlatformColumnMapping[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([requestIp, createdAt])
}

model PasswordResetAttempt {
  id              String   @id @default(cuid())
  emailNormalized String
  requestIp       String?
  createdAt       DateTime @default(now())

  @@index([emailNormalized, createdAt])
  @@index([requestIp, createdAt])
}

model Property {
  id           String          @id @default(cuid())
  userId       String
  name         String
  address      String
  city         String
  country      String
  propertyType   String
  residencyStatus String?
  airbnbUrl    String?
  bookingUrl   String?
  vrboUrl      String?
  notes        String?
  archived     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration Registration?
  checklistItems ChecklistItem[]
  playbookProgress PlaybookStepProgress[]
  listingPlatformProgress ListingPlatformProgress[]
  listingChannels ListingChannel[]
  listingHealthSnapshots ListingHealthSnapshot[]
  notifications  Notification[]
  guestRegisterToken GuestRegisterToken?
  calendarFeeds CalendarFeed[]
  guestStays   GuestStay[]
  guestRecords GuestRecord[]
  sesCredential SesCredential?
  alloggiatiCredential AlloggiatiCredential?
  sesSubmissions SesSubmission[]
  regionalGuestReports RegionalGuestReport[]
  nightCapSettings NightCapSettings?
  capGuardPolicy CapGuardPolicy?
  capGuardEvents CapGuardEvent[]
  touristTaxSettings TouristTaxSettings?
  touristTaxPeriods TouristTaxPeriod[]
  platformImports PlatformImport[]
  platformReservations PlatformReservation[]
  reconciliationFindings ReconciliationFinding[]
  dac7ListingOverviews Dac7ListingOverview[]
  platformColumnMappings PlatformColumnMapping[]
  ruleImpacts RuleImpact[]
}

model TouristTaxSettings {
  id                 String   @id @default(cuid())
  propertyId         String   @unique
  enabled            Boolean  @default(true)
  collectionMode     String   @default("unknown")
  declarationCadence String   @default("monthly")
  portalUrl          String?
  classification     String   @default("unclassified")
  attestationOnFile  Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model TouristTaxPeriod {
  id                  String    @id @default(cuid())
  propertyId          String
  periodStart         DateTime
  periodEnd           DateTime
  status              String    @default("upcoming")
  nightsInPeriod      Int?
  declaredAt          DateTime?
  declarationChannel  String?
  amountCents         Int?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodStart])
  @@index([propertyId])
  @@index([propertyId, status])
}

model NightCapSettings {
  id              String    @id @default(cuid())
  propertyId      String    @unique
  nightCapEnabled Boolean   @default(true)
  nightCapLimit   Int       @default(120)
  nightCapYear    Int
  nightCapSource  String    @default("statutory_120")
  notes           String?
  nightsUsedYtd   Int?
  lastComputedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model CapGuardPolicy {
  id                      String    @id @default(cuid())
  propertyId              String    @unique
  enabled                 Boolean   @default(false)
  mode                    String    @default("BUFFER")
  bufferNights            Int       @default(7)
  budgetWindows           String    @default("[]")
  registrationGate        Boolean   @default(false)
  feedToken               String    @unique
  feedTokenRotatedAt      DateTime?
  propagationConfirmedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  property                Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model CapGuardEvent {
  id         String   @id @default(cuid())
  propertyId String
  eventType  String
  payload    String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, createdAt])
}

model CalendarFeed {
  id           String    @id @default(cuid())
  propertyId   String
  url          String
  sourceLabel  String?
  enabled      Boolean   @default(true)
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestStays   GuestStay[]

  @@unique([propertyId, url])
  @@index([propertyId])
  @@index([enabled])
}

model GuestRegisterToken {
  id         String   @id @default(cuid())
  propertyId String   @unique
  token      String   @unique
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  expiresAt  DateTime?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model GuestStay {
  id                  String        @id @default(cuid())
  propertyId          String
  calendarFeedId      String?
  externalUid         String?
  checkInDate         DateTime
  checkOutDate        DateTime
  expectsForeignGuest Boolean       @default(true)
  guestLabel          String?
  source              String        @default("manual")
  importStatus        String?
  notes               String?
  createdAt           DateTime      @default(now())
  property            Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  calendarFeed        CalendarFeed? @relation(fields: [calendarFeedId], references: [id], onDelete: SetNull)
  guestRecords        GuestRecord[]
  sesSubmissions      SesSubmission[]
  regionalGuestReports RegionalGuestReport[]
  platformReservations PlatformReservation[]

  @@unique([propertyId, externalUid])
  @@index([propertyId])
  @@index([propertyId, checkInDate])
  @@index([calendarFeedId])
}

model GuestRecord {
  id                      String    @id @default(cuid())
  propertyId              String
  stayId                  String?
  lastName                String
  firstNames              String
  dateOfBirth             DateTime
  placeOfBirth            String
  nationality             String
  usualAddress            String
  mobile                  String
  email                   String
  arrivalDate             DateTime
  departureDate           DateTime
  isFrenchNational        Boolean   @default(false)
  requiresPoliceForm      Boolean   @default(true)
  signatureDataUrl        String?
  signedAt                DateTime?
  submittedAt             DateTime?
  retentionExpiresAt      DateTime?
  accompanyingChildrenJson String?
  documentType            String?
  documentNumber          String?
  documentSupport         String?
  sex                     String?
  kinship                 String?
  postalCode              String?
  municipalityCode        String?
  municipalityName        String?
  addressCountryAlpha3    String?
  createdAt               DateTime  @default(now())
  property                Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay                    GuestStay? @relation(fields: [stayId], references: [id], onDelete: SetNull)
  sesSubmissions          SesSubmission[]

  @@index([propertyId, retentionExpiresAt])
}

model SesCredential {
  id                    String    @id @default(cuid())
  propertyId            String    @unique
  codigoArrendador      String
  wsUsernameEncrypted   String
  wsPasswordEncrypted   String
  codigoEstablecimiento String
  liveSubmitEnabled     Boolean   @default(false)
  lastTestedAt          DateTime?
  lastTestStatus        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model AlloggiatiCredential {
  id                  String    @id @default(cuid())
  propertyId          String    @unique
  utente              String
  passwordEncrypted   String
  wsKeyEncrypted      String
  liveSubmitEnabled   Boolean   @default(false)
  lastTestedAt        DateTime?
  lastTestStatus      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SesSubmission {
  id                   String       @id @default(cuid())
  propertyId           String
  stayId               String?
  guestRecordId        String?
  status               String       @default("queued")
  mode                 String       @default("dry_run")
  correlationId        String?
  loteCode             String?
  governmentCode       String?
  governmentMessage    String?
  validationErrorsJson String?
  requestSummaryJson   String?
  submittedAt          DateTime?
  respondedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  property             Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay                 GuestStay?   @relation(fields: [stayId], references: [id], onDelete: SetNull)
  guestRecord          GuestRecord? @relation(fields: [guestRecordId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([propertyId, status])
  @@index([stayId])
  @@index([guestRecordId])
}

model RegionalGuestReport {
  id          String    @id @default(cuid())
  propertyId  String
  stayId      String?
  system      String
  status      String    @default("prepared")
  notes       String?
  preparedAt  DateTime  @default(now())
  submittedAt DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay        GuestStay? @relation(fields: [stayId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([propertyId, status])
  @@index([stayId])
}

model PlaybookStepProgress {
  id          String    @id @default(cuid())
  propertyId  String
  stepKey     String
  status      String    @default("pending")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, stepKey])
}

model ListingPlatformProgress {
  id          String    @id @default(cuid())
  propertyId  String
  platform    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, platform])
}

model ListingChannel {
  id                          String    @id @default(cuid())
  propertyId                  String
  channel                     String
  listingUrl                  String
  registrationNumberDisplayed String?
  displayStatus               String    @default("UNKNOWN")
  lastCheckedAt               DateTime?
  notes                       String?
  blockedAt                   DateTime?
  blockReason                 String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  property                    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, channel])
  @@index([propertyId])
  @@index([displayStatus])
}

model ListingHealthSnapshot {
  id             String   @id @default(cuid())
  propertyId     String
  score          String
  factorsJson    String   @default("[]")
  computedAt     DateTime @default(now())
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, computedAt])
  @@index([propertyId])
}

model Registration {
  id                        String    @id @default(cuid())
  propertyId                String    @unique
  registrationNumber        String?
  issuingAuthority          String?
  status                    String    @default("not_started")
  issueDate                 DateTime?
  expiryDate                DateTime?
  notes                     String?
  nationalRegistrationNumber String?
  nationalTransitionStatus  String    @default("not_applicable")
  nationalRenewalDeadline   DateTime?
  /** Italy CIN (Codice Identificativo Nazionale) via BDSR — separate from regional CIR/SCIA */
  cinNumber                 String?
  cinBdsrStatus             String    @default("not_started")
  cinDisplayedOnListings    Boolean   @default(false)
  /** Portugal RNAL (Registo Nacional de Alojamento Local) — Turismo de Portugal */
  rnalNumber                String?
  rnalStatus                String    @default("not_started")
  rnalDisplayedOnListings   Boolean   @default(false)
  /** Greece AMA (Αριθμός Μητρώου Ακινήτου) — AADE Short-Term Stay Property Registry */
  amaNumber                 String?
  amaStatus                 String    @default("not_started")
  amaDisplayedOnListings    Boolean   @default(false)
  greeceRegistrationKind    String    @default("ama")
  greeceAlternateLicenseNumber String?
  atak                      String?
  /** Croatia tourist accommodation categorisation / object registration — Ministry of Tourism */
  hrCategorisationNumber    String?
  hrObjectId                String?
  hrCategorisationStatus    String    @default("not_started")
  hrCategorisationDisplayedOnListings Boolean @default(false)
  /** Netherlands national tourist rental registration (toeristische verhuur) */
  nlRegistrationNumber      String?
  nlRegistrationStatus      String    @default("not_started")
  nlRegistrationDisplayedOnListings Boolean @default(false)
  /** Netherlands holiday-rental permit (e.g. Amsterdam vergunning) */
  nlHolidayPermitStatus     String    @default("not_started")
  nlHolidayPermitExpiry     DateTime?
  nlPermitNumber            String?
  /** Amsterdam wijk key for 15-night cap zones (from 1 Apr 2026) */
  nlNeighborhood            String?
  /** Night-cap limit source: amsterdam_30 | amsterdam_15 | nl_municipal | none */
  nlNightCapSource          String    @default("none")
  /** Belgium regional STR registration (Brussels / Flanders / Wallonia) */
  beRegistrationNumber      String?
  beRegistrationStatus      String    @default("not_started")
  beRegistrationDisplayedOnListings Boolean @default(false)
  beRegion                  String?
  beOperatorCategory        String?
  beFireSafetyStatus        String    @default("not_started")
  beInsuranceStatus         String    @default("not_started")
  beUrbanPlanningStatus     String    @default("not_started")
  beDossierSubmittedAt      DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  property                  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  frNerMigration            FrNerMigration?
}

model FrNerMigration {
  id                      String       @id @default(cuid())
  registrationId          String       @unique
  status                  String       @default("NO_LOCAL")
  localRegistrationNumber String?
  localIssuingCommune     String?
  nerNumber               String?
  nerIssuedAt             DateTime?
  transitionEndsAt        DateTime?
  documentsChecklist      String       @default("[]")
  channelUpdatesChecklist String       @default("[]")
  notifyOnPortalOpen      Boolean      @default(false)
  wizardStep              String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  registration            Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id         String   @id @default(cuid())
  propertyId String
  title      String
  completed  Boolean  @default(false)
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model EvidencePackEvent {
  id             String   @id @default(cuid())
  registrationId String
  generatedAt    DateTime @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  locale         String

  @@index([registrationId])
  @@index([generatedAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  propertyId String?
  title      String
  message    String
  type       String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

model PlatformImport {
  id              String                @id @default(cuid())
  propertyId      String
  channel         String
  filename        String?
  rowCount        Int                   @default(0)
  createdAt       DateTime              @default(now())
  createdByUserId String
  property        Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  reservations    PlatformReservation[]

  @@index([propertyId])
  @@index([propertyId, createdAt])
}

model PlatformReservation {
  id               String          @id @default(cuid())
  propertyId       String
  importId         String?
  channel          String
  externalRef      String?
  listingRef       String?
  checkIn          DateTime
  checkOut         DateTime
  nights           Int
  guests           Int?
  status           String          @default("confirmed")
  grossAmountCents Int?
  matchedStayId    String?
  createdAt        DateTime        @default(now())
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  import           PlatformImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  matchedStay      GuestStay?      @relation(fields: [matchedStayId], references: [id], onDelete: SetNull)

  @@unique([propertyId, channel, externalRef])
  @@index([propertyId])
  @@index([propertyId, checkIn])
  @@index([importId])
  @@index([matchedStayId])
}

model ReconciliationFinding {
  id             String    @id @default(cuid())
  propertyId     String
  periodStart    DateTime
  periodEnd      DateTime
  code           String
  severity       String
  expectedJson   String    @default("{}")
  observedJson   String    @default("{}")
  sourceRefsJson String    @default("[]")
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, periodStart])
  @@index([propertyId, resolvedAt])
  @@index([propertyId, code])
}

model Dac7ListingOverview {
  id                   String   @id @default(cuid())
  propertyId           String
  year                 Int
  channel              String
  listingRef           String   @default("")
  daysRented           Int
  q1ConsiderationCents Int?
  q2ConsiderationCents Int?
  q3ConsiderationCents Int?
  q4ConsiderationCents Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, year, channel, listingRef])
  @@index([propertyId, year])
}

model PlatformColumnMapping {
  id          String   @id @default(cuid())
  propertyId  String
  userId      String
  channel     String   @default("GENERIC")
  mappingJson String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId, channel])
}

model JurisdictionRule {
  id            String    @id @default(cuid())
  key           String
  country       String
  city          String?
  zone          String?
  residency     String?
  valueJson     String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  sourceUrl     String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([key, country, city])
  @@index([effectiveFrom])
}

model RuleChange {
  id            String       @id @default(cuid())
  ruleKeysJson  String
  summaryEn     String
  summaryFr     String
  confidence    String
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  impacts       RuleImpact[]
}

model RuleImpact {
  id           String     @id @default(cuid())
  ruleChangeId String
  propertyId   String
  beforeJson   String
  afterJson    String
  severity     String
  seenAt       DateTime?
  createdAt    DateTime   @default(now())
  ruleChange   RuleChange @relation(fields: [ruleChangeId], references: [id], onDelete: Cascade)
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, seenAt])
  @@index([ruleChangeId])
  @@index([propertyId])
}
