# =============================================================================
# Glint Host Registry — environment variables
# =============================================================================
#
# Convention by deployment target:
#
#   Local dev     → SQLite + Stripe TEST keys (sk_test / pk_test)
#   Vercel Preview → Turso or SQLite + Stripe TEST keys (safe for PR QA)
#   Vercel Production (pre go-live) → Turso + Stripe TEST keys
#   Vercel Production (go-live)     → Turso + Stripe LIVE keys (sk_live / pk_live)
#                                   → SES_LIVE stays "false" until Spain go-live
#
# Go-live checklist: see GO_LIVE.md
# =============================================================================

# --- Database ---
# Local: SQLite file
DATABASE_URL="file:./dev.db"
# Production (Turso): libsql URL + auth token
# DATABASE_URL="libsql://glint-host-registry-xxxx.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# --- App URL (required for Stripe redirects) ---
# Local: http://localhost:4311
# Production: https://glint-host-registry.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:4311"

# --- Stripe ---
#
# Preview & local: use TEST mode keys and test Price IDs
# Production at go-live: swap to LIVE keys and live Price IDs (see GO_LIVE.md)
#
# STRIPE_LIVE_PRICE_STARTER / STRIPE_LIVE_PRICE_PRO are placeholders in GO_LIVE.md
# for Money Maker to fill — the actual env var names are below.
#
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Cron (iCal daily sync) ---
# Required on Vercel Production. Generate with: openssl rand -base64 32
# Vercel Cron (vercel.json) invokes GET /api/cron/sync-calendars daily at 04:00 UTC
# and sends Authorization: Bearer <CRON_SECRET>
# Manual test: curl -H "Authorization: Bearer $CRON_SECRET" https://your-app.vercel.app/api/cron/sync-calendars
CRON_SECRET="your-cron-secret-here"

# --- SES.HOSPEDAJES (Spain guest reporting) ---
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY="your-32-byte-base64-encryption-key"
# Keep "false" at billing go-live — enables live SOAP submissions only when deliberately flipped
SES_LIVE="false"
